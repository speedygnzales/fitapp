<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_outline"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/flame_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Streak"
            android:src="@drawable/ic_flame_soft" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:letterSpacing="0.12"
            android:text="STREAK"
            android:textColor="#CCE6E6E6"
            android:textSize="10sp"
            android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="3" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/freeze_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/2"
            android:textColor="#CCE6E6E6"
            android:textSize="11sp"
            android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="3" />

        <ImageView
            android:id="@+id/freeze1"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="5dp"
            android:contentDescription="Freezes"
            android:src="@drawable/ic_freeze_soft_on" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/streak_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:text="0"
            android:textColor="#E6E6E6"
            android:textSize="42sp"
            android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="3" />

        <TextView
            android:id="@+id/streak_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="5dp"
            android:text="days"
            android:textColor="#CCE6E6E6"
            android:textSize="12sp"
            android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="3" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/d0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="M"
                android:textColor="#B3E6E6E6"
                android:textSize="9sp"
                android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="3" />

            <ImageView
                android:id="@+id/s0"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/sq_miss_s"
                android:contentDescription="Day 1"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/leer" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/d1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="M"
                android:textColor="#B3E6E6E6"
                android:textSize="9sp"
                android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="3" />

            <ImageView
                android:id="@+id/s1"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/sq_miss_s"
                android:contentDescription="Day 2"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/leer" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/d2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="M"
                android:textColor="#B3E6E6E6"
                android:textSize="9sp"
                android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="3" />

            <ImageView
                android:id="@+id/s2"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/sq_miss_s"
                android:contentDescription="Day 3"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/leer" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/d3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="M"
                android:textColor="#B3E6E6E6"
                android:textSize="9sp"
                android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="3" />

            <ImageView
                android:id="@+id/s3"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/sq_miss_s"
                android:contentDescription="Day 4"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/leer" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/d4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="M"
                android:textColor="#B3E6E6E6"
                android:textSize="9sp"
                android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="3" />

            <ImageView
                android:id="@+id/s4"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/sq_miss_s"
                android:contentDescription="Day 5"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/leer" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/d5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="M"
                android:textColor="#B3E6E6E6"
                android:textSize="9sp"
                android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="3" />

            <ImageView
                android:id="@+id/s5"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/sq_miss_s"
                android:contentDescription="Day 6"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/leer" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/d6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:text="M"
                android:textColor="#E6E6E6"
                android:textSize="9sp"
                android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="3" />

            <ImageView
                android:id="@+id/s6"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/sq_open_s"
                android:contentDescription="Day 7"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/leer" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
